---
import { sites } from "../lib/sites";
import Spa from "../templates/Spa.astro";
import Restaurante from "../templates/Restaurante.astro";
import Consultorio from "../templates/Consultorio.astro";
import Fitness from "../templates/Fitness.astro";

export function getStaticPaths() {
  return sites.map((site) => ({ params: { slug: site.slug }, props: { site } }));
}
const { site } = Astro.props;
const plantillas = { spa: Spa, restaurante: Restaurante, consultorio: Consultorio, fitness: Fitness } as const;
const Plantilla = plantillas[site.giro];
if (!Plantilla) throw new Error(`Giro sin plantilla: ${site.giro} (${site.slug})`);
---
<Plantilla site={site} />
