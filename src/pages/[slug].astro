---
import { sites } from "../lib/sites";
import Spa from "../templates/Spa.astro";
import Restaurant from "../templates/Restaurant.astro";
import Clinic from "../templates/Clinic.astro";
import Fitness from "../templates/Fitness.astro";

export function getStaticPaths() {
  return sites.map((site) => ({ params: { slug: site.slug }, props: { site } }));
}
const { site } = Astro.props;
const templates = { spa: Spa, restaurant: Restaurant, clinic: Clinic, fitness: Fitness } as const;
const Template = templates[site.category];
if (!Template) throw new Error(`No template for category: ${site.category} (${site.slug})`);
---
<Template site={site} />
