---
/** Shared HTML head: title, description, og: tags with the business logo, fonts.
 *  `theme` scopes each template's CSS: all templates share one CSS bundle, so their globals must hang off html[data-theme]. */
import "../styles/base.css";
import type { Site } from "../lib/sites";
interface Props { site: Site; theme: string; fonts?: string; themeColor: string; colors: Record<string, string> }
const { site, theme, fonts, themeColor, colors } = Astro.props;
const vars = `:root{${Object.entries(colors).map(([k, v]) => `--${k}:${v}`).join(";")}}`;
const title = `${site.name} · ${site.tagline}`;
const canonical = new URL(`/${site.slug}/`, Astro.site).toString();
const ogImage = site.logo ? new URL(site.logo, Astro.site).toString() : null;
const schemaType = ({
  restaurant: "Restaurant",
  spa: "DaySpa",
  clinic: site.subcategory === "dental" ? "Dentist" : site.subcategory === "veterinary" ? "VeterinaryCare" : "MedicalClinic",
  fitness: "ExerciseGym",
  bakery: "Bakery",
  store: "FurnitureStore",
  florist: "Florist",
  catering: "FoodEstablishment",
} as Record<string, string>)[site.category];
---
<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {site.demo && <meta name="robots" content="noindex" />}
    {fonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {fonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fonts && <link rel="stylesheet" href={fonts} />}
    <style is:inline set:html={vars} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": schemaType,
      name: site.name,
      description: site.description,
      telephone: site.phone,
      address: site.address,
      url: canonical,
      image: ogImage ?? undefined,
    })} />
  </head>
  <body>
    <slot />
    {site.demo && <div class="demo-tag">Demostración · ACCIO</div>}
  </body>
</html>
