---
/**
 * RESTAURANT template — visual world: the printed menu on the tablecloth.
 * Light paper, ink, a single wine color. The name is the sign, the menu uses dotted leaders
 * (the real convention of printed menus), and the reservation is a form that opens WhatsApp with everything filled in.
 */
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/instrument-sans";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import { type Site, formatPrice, bookingLink, telLink, waNumber, textOn } from "../lib/sites";

interface Props { site: Site }
const { site } = Astro.props;
const c = {
  bg: "#FFFCF6",
  ink: "#1C1A17",
  brand: "#7A1F2B",
  paper: "#F4EEE3",
  ...(site.colors ?? {}),
};
const cta = bookingLink(site);
const tel = telLink(site);
const wa = waNumber(site);
const timeSlots = ["8:00","9:00","10:00","11:00","12:00","13:00","14:00","15:00","16:00","17:00","18:00","19:00","20:00","21:00"];
const today = new Date().toISOString().slice(0, 10);
---
<Base site={site} theme="restaurant" themeColor={c.brand} colors={{ ...c, "on-brand": textOn(c.brand) }}>
  <style>
    :global(html[data-theme="restaurant"]) {
      --ink-2: color-mix(in oklab, var(--ink) 64%, var(--bg));
      --line: color-mix(in oklab, var(--ink) 16%, transparent);
      --f-display: "Fraunces Variable", Georgia, serif;
      --f-body: "Instrument Sans Variable", system-ui, sans-serif;
    }
    :global(html[data-theme="restaurant"] body) { background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 16px; line-height: 1.55; }

    /* Sign */
    .sign { text-align: center; padding-block: 28px 10px; max-width: 980px; margin-inline: auto; }
    .sign :global(.mark) { margin-inline: auto; }
    .sign h1 { margin-top: 18px; font-family: var(--f-display); font-weight: 900; font-variation-settings: "opsz" 144, "SOFT" 60; font-size: clamp(2.8rem, 10vw, 7rem); line-height: .92; letter-spacing: -.035em; text-wrap: balance; color: var(--brand); }
    .sign h1 { opacity: 1; transform: none; transition: opacity 600ms var(--ease-out), transform 600ms var(--ease-out); }
    @starting-style { .sign h1 { opacity: 0; transform: translateY(10px); } }
    .sign .tag { margin-top: 14px; font-family: var(--f-display); font-style: italic; font-weight: 500; font-size: clamp(1.15rem, 2.6vw, 1.5rem); color: var(--ink-2); }
    .rule { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px; margin: 26px auto 0; max-width: 980px; color: var(--brand); }
    .rule::before, .rule::after { content: ""; height: 3px; border-top: 1px solid currentColor; border-bottom: 1px solid currentColor; transform-origin: center; transform: scaleX(1); transition: transform 900ms var(--ease-out) 150ms; }
    @starting-style { .rule::before, .rule::after { transform: scaleX(0); } }

    .intro { max-width: 62ch; margin: 28px auto 0; text-align: center; font-size: 1.08rem; color: var(--ink-2); text-wrap: pretty; }

    /* Reserve: a real form */
    .reserve { max-width: 760px; margin: 32px auto 0; background: var(--paper); border-radius: 20px; padding: 18px; display: grid; gap: 10px; grid-template-columns: 1fr; }
    @media (min-width: 640px) { .reserve { grid-template-columns: 1fr 1fr 1fr auto; align-items: end; } }
    .reserve label { display: grid; gap: 6px; font-size: .8rem; font-weight: 600; letter-spacing: .02em; color: var(--ink-2); }
    .reserve select, .reserve input { height: 48px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font: inherit; font-size: 1rem; width: 100%; appearance: none; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 48px; padding: 0 20px; border-radius: 12px; background: var(--brand); color: var(--on-brand); font-weight: 600; text-decoration: none; white-space: nowrap; transition: transform var(--t-fast) var(--ease-out), filter var(--t-fast) var(--ease-out); }
    .btn:hover { filter: brightness(1.08); } .btn:active { transform: scale(.98); }
    .reserve .hint { grid-column: 1 / -1; font-size: .85rem; color: var(--ink-2); margin: 0; }

    .photos { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); max-width: 980px; margin: 40px auto 0; }
    .photos img { aspect-ratio: 1; object-fit: cover; border-radius: 14px; }

    /* The menu */
    .menu { max-width: 980px; margin: 56px auto 0; columns: 1; column-gap: 56px; }
    @media (min-width: 820px) { .menu { columns: 2; } }
    .group { break-inside: avoid; margin-bottom: 40px; }
    .group h2 { font-family: var(--f-display); font-weight: 700; font-variation-settings: "opsz" 72; font-size: 1.9rem; letter-spacing: -.02em; color: var(--brand); }
    .group .note { color: var(--ink-2); font-size: .92rem; margin-top: 4px; }
    .dishes { margin-top: 14px; display: grid; gap: 14px; }
    .dish .line { display: flex; align-items: baseline; gap: 8px; }
    .dish .n { font-weight: 600; font-size: 1.05rem; }
    .dish .n .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--brand); margin-left: 8px; vertical-align: middle; }
    .dish .leader { flex: 1; border-bottom: 2px dotted var(--line); transform: translateY(-5px); min-width: 16px; }
    .dish .p { font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
    .dish .d { color: var(--ink-2); font-size: .93rem; margin-top: 2px; max-width: 48ch; }

    .info { max-width: 980px; margin: 24px auto 0; padding: 28px 0 56px; border-top: 1px solid var(--line); display: grid; gap: 28px; grid-template-columns: 1fr; }
    @media (min-width: 760px) { .info { grid-template-columns: 1fr 1fr; gap: 48px; } }
    .info h2 { font-family: var(--f-display); font-weight: 700; font-size: 1.5rem; margin-bottom: 12px; }
    .hours li { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px dotted var(--line); }
    .hours li span:last-child { font-variant-numeric: tabular-nums; color: var(--ink-2); }
    .details { display: grid; gap: 12px; }
    .details a, .details p { display: flex; gap: 12px; align-items: flex-start; text-decoration: none; line-height: 1.4; }
    .details a:hover { text-decoration: underline; }
    .details :global(svg) { flex: 0 0 auto; margin-top: 2px; color: var(--brand); }

    footer { background: var(--brand); color: var(--on-brand); padding-block: 26px calc(26px + 72px); font-size: .9rem; }
    footer .in { max-width: 1020px; margin-inline: auto; display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: center; }
    footer a { text-decoration: none; }

    .bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 10px max(16px, env(safe-area-inset-left,0px)) calc(10px + env(safe-area-inset-bottom,0px)) max(16px, env(safe-area-inset-right,0px)); background: color-mix(in oklab, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-top: 1px solid var(--line); }
    .bar .btn { width: 100%; }
    @media (min-width: 760px) { .bar { display: none; } footer { padding-bottom: 26px; } }
  </style>

  <main class="gutter">
    <header class="sign">
      <Mark name={site.name} logo={site.logo} size={72} />
      <h1>{site.name}</h1>
      <p class="tag">{site.tagline}</p>
      <div class="rule" aria-hidden="true"><Icon name="fork" size={22} /></div>
    </header>

    <p class="intro">{site.description}</p>

    {wa && (
      <form class="reserve" id="reserve" data-wa={wa} data-name={site.name}>
        <label>Personas
          <select name="guests" id="guests">{[1,2,3,4,5,6,7,8].map((n) => <option value={n} selected={n === 2}>{n}</option>)}</select>
        </label>
        <label>Día
          <input type="date" name="date" id="date" min={today} value={today} required />
        </label>
        <label>Hora
          <select name="time" id="time">{timeSlots.map((h) => <option value={h} selected={h === "14:00"}>{h}</option>)}</select>
        </label>
        <button class="btn" type="submit"><Icon name="whatsapp" size={18} /> Reservar</button>
        <p class="hint">Te confirmamos la mesa por WhatsApp. Grupos de más de 8, escríbenos directo.</p>
      </form>
    )}
    {!wa && cta && <p style="text-align:center;margin-top:28px"><a class="btn" href={cta.url}>{cta.label}</a></p>}

    {site.photos?.length ? <div class="photos">{site.photos.map((f) => <img src={f} alt="" loading="lazy" />)}</div> : null}

    <section class="menu" id="menu" aria-label="Carta">
      {site.sections.map((s) => (
        <div class="group">
          <h2>{s.title}</h2>
          {s.note && <p class="note">{s.note}</p>}
          <ul class="dishes">
            {s.items.map((it) => (
              <li class="dish">
                <div class="line">
                  <span class="n">{it.name}{it.featured && <span class="dot" title="Favorito de la casa" />}</span>
                  {typeof it.price === "number" && <><span class="leader" /><span class="p">{formatPrice(it.price)}</span></>}
                </div>
                {it.description && <p class="d">{it.description}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="info" id="visit">
      <div>
        <h2>Horario</h2>
        <ul class="hours">{site.hours.map((h) => <li><span>{h.days}</span><span>{h.time}</span></li>)}</ul>
      </div>
      <div>
        <h2>Dónde</h2>
        <div class="details">
          {site.address && (site.mapUrl
            ? <a href={site.mapUrl} target="_blank" rel="noreferrer"><Icon name="pin" /> <span>{site.address}</span></a>
            : <p><Icon name="pin" /> <span>{site.address}</span></p>)}
          {tel && <a href={tel}><Icon name="phone" /> <span>{site.phone}</span></a>}
          {site.instagram && <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noreferrer"><Icon name="instagram" /> <span>@{site.instagram}</span></a>}
          {site.facebook && <a href={`https://facebook.com/${site.facebook}`} target="_blank" rel="noreferrer"><Icon name="facebook" /> <span>Facebook</span></a>}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="in gutter">
      <span>{site.name}</span>
      {site.instagram && <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noreferrer">@{site.instagram}</a>}
    </div>
  </footer>

  {cta && <div class="bar"><a class="btn" href={cta.url} target="_blank" rel="noreferrer"><Icon name="whatsapp" size={18} /> {cta.label}</a></div>}

  <script>
    const f = document.getElementById("reserve") as HTMLFormElement | null;
    f?.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = (id: string) => (f.querySelector<HTMLInputElement | HTMLSelectElement>("#" + id)?.value ?? "");
      const [y, m, d] = v("date").split("-").map(Number);
      const date = new Date(y, m - 1, d).toLocaleDateString("es-MX", { weekday: "long", day: "numeric", month: "long" });
      const msg = `Hola, ${f.dataset.name}. Quiero reservar mesa para ${v("guests")} el ${date} a las ${v("time")}.`;
      window.open(`https://wa.me/${f.dataset.wa}?text=${encodeURIComponent(msg)}`, "_blank", "noopener");
    });
  </script>
</Base>
