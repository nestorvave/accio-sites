---
/**
 * Plantilla CONSULTORIO — dental, medicina estética, veterinaria.
 * Mundo visual: la tarjeta de cita. Luz de consultorio (fondo frío y claro), un solo color de confianza,
 * serif de respeto + sans clara. La acción principal es la tarjeta de cita misma: tratamiento + día + turno → WhatsApp.
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import { type Site, precio, reservaLink, telLink, waNumber, textoSobre } from "../lib/sites";

interface Props { site: Site }
const { site } = Astro.props;
const c = { fondo: "#F6F9FA", tinta: "#10232B", marca: "#0E6F7A", papel: "#E4EEF0", ...(site.colores ?? {}) };
const cta = reservaLink(site);
const tel = telLink(site);
const wa = waNumber(site);
const fonts = "https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Figtree:wght@400;500;600;700&display=swap";
const v = {
  dental: { quien: "paciente", accion: "Agenda tu cita", lista: "Tratamientos", nota: "Primera consulta con valoración y plan de tratamiento por escrito.", hint: "Te confirmamos horario en minutos. Urgencias: escríbenos directo." },
  estetica: { quien: "paciente", accion: "Agenda tu valoración", lista: "Tratamientos", nota: "Toda valoración incluye diagnóstico y propuesta a tu medida; sin compromiso.", hint: "Te confirmamos horario en minutos." },
  veterinaria: { quien: "mascota", accion: "Agenda una consulta", lista: "Servicios", nota: "Urgencias las 24 horas: llámanos antes de salir de casa.", hint: "Te confirmamos horario en minutos. Si es urgencia, llama." },
  medico: { quien: "paciente", accion: "Agenda tu cita", lista: "Servicios", nota: "", hint: "Te confirmamos horario en minutos." },
  despacho: { quien: "cliente", accion: "Agenda una asesoría", lista: "Servicios", nota: "Primera reunión sin costo: revisamos tu situación y te decimos qué conviene.", hint: "Te confirmamos horario en minutos. Atendemos en oficina o por videollamada." },
}[site.subgiro ?? "medico"];
const hoy = new Date().toISOString().slice(0, 10);
const turnos = ["Mañana", "Mediodía", "Tarde"];
---
<Base site={site} fonts={fonts} themeColor={c.marca} colores={{ ...c, "sobre-marca": textoSobre(c.marca) }}>
  <style>
    :global(:root) {
      --tinta-2: color-mix(in oklab, var(--tinta) 62%, var(--fondo));
      --linea: color-mix(in oklab, var(--tinta) 14%, transparent);
      --f-display: "DM Serif Display", Georgia, serif;
      --f-body: "Figtree", system-ui, sans-serif;
    }
    :global(body) { background: var(--fondo); color: var(--tinta); font-family: var(--f-body); font-size: 16px; line-height: 1.55; }
    .wrap { max-width: 1040px; margin-inline: auto; }

    .top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 18px; }
    .top .name { min-width: 0; display: flex; align-items: center; gap: 12px; font-weight: 700; letter-spacing: -.01em; text-decoration: none; }
    .top .tel { white-space: nowrap; flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--linea); text-decoration: none; font-weight: 500; font-size: .92rem; font-variant-numeric: tabular-nums; }
    .top .tel:hover { background: var(--papel); }

    .hero { display: grid; gap: 28px; padding-block: clamp(28px, 6vw, 64px) clamp(28px, 5vw, 56px); align-items: center; }
    @media (min-width: 860px) { .hero { grid-template-columns: 1.1fr 1fr; gap: 56px; } }
    .hero h1 { font-family: var(--f-display); font-weight: 400; font-size: clamp(2.3rem, 6vw, 4.2rem); line-height: 1.02; letter-spacing: -.015em; text-wrap: balance; max-width: 16ch; }
    .hero h1 em { font-style: italic; color: var(--marca); }
    .hero p { margin-top: 18px; max-width: 54ch; font-size: 1.05rem; color: var(--tinta-2); }
    .hero h1, .hero p { opacity: 1; transform: none; transition: opacity 600ms var(--ease-out), transform 600ms var(--ease-out); }
    .hero p { transition-delay: 90ms; }
    @starting-style { .hero h1, .hero p { opacity: 0; transform: translateY(10px); } }

    /* La tarjeta de cita: perforación arriba, datos en filas, botón al pie */
    .cita { position: relative; background: #fff; border-radius: 22px; box-shadow: 0 18px 40px -24px color-mix(in oklab, var(--tinta) 45%, transparent), 0 1px 0 var(--linea); padding: 22px 22px 20px; display: grid; gap: 14px; }
    .cita::before { content: ""; position: absolute; left: 50%; top: 10px; transform: translateX(-50%); width: 44px; height: 6px; border-radius: 999px; background: var(--papel); }
    .cita h2 { font-family: var(--f-display); font-weight: 400; font-size: 1.5rem; margin-top: 10px; }
    .cita label { display: grid; gap: 6px; font-size: .78rem; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: var(--tinta-2); }
    .cita select, .cita input { height: 48px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--linea); background: var(--fondo); color: var(--tinta); font: inherit; font-size: 1rem; width: 100%; appearance: none; }
    .cita .row { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 50px; padding: 0 20px; border-radius: 12px; background: var(--marca); color: var(--sobre-marca); font-weight: 600; text-decoration: none; transition: transform var(--t-fast) var(--ease-out), filter var(--t-fast) var(--ease-out); }
    .btn:hover { filter: brightness(1.07); } .btn:active { transform: scale(.98); }
    .cita .hint { font-size: .85rem; color: var(--tinta-2); margin: 0; }

    .lista { padding-block: 8px 48px; }
    .lista h2 { font-family: var(--f-display); font-weight: 400; font-size: clamp(1.8rem, 3.6vw, 2.4rem); }
    .lista .nota { color: var(--tinta-2); max-width: 60ch; margin-top: 6px; }
    .grupo { margin-top: 28px; }
    .grupo h3 { font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--marca); font-weight: 700; }
    .items { margin-top: 10px; display: grid; gap: 0; border-top: 1px solid var(--linea); }
    .item { display: grid; grid-template-columns: 1fr auto; gap: 2px 16px; padding: 14px 0; border-bottom: 1px solid var(--linea); align-items: baseline; }
    .item .n { font-weight: 600; font-size: 1.05rem; }
    .item .n .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--marca); margin-left: 8px; vertical-align: middle; }
    .item .p { font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
    .item .p small { display: block; color: var(--tinta-2); font-weight: 400; font-size: .85rem; text-align: right; }
    .item .d { grid-column: 1 / -1; color: var(--tinta-2); font-size: .95rem; max-width: 62ch; }

    .fotos { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); padding-bottom: 40px; }
    .fotos img { aspect-ratio: 4 / 3; object-fit: cover; border-radius: 14px; }

    .ficha { background: var(--papel); border-radius: 22px; padding: 26px 22px; display: grid; gap: 26px; grid-template-columns: 1fr; margin-bottom: 40px; }
    @media (min-width: 760px) { .ficha { grid-template-columns: 1fr 1fr; gap: 40px; padding: 32px; } }
    .ficha h2 { font-family: var(--f-display); font-weight: 400; font-size: 1.5rem; margin-bottom: 12px; }
    .horas li { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--linea); }
    .horas li span:last-child { font-variant-numeric: tabular-nums; color: var(--tinta-2); }
    .datos { display: grid; gap: 12px; }
    .datos a, .datos p { display: flex; gap: 12px; align-items: flex-start; text-decoration: none; line-height: 1.4; }
    .datos a:hover { text-decoration: underline; }
    .datos :global(svg) { flex: 0 0 auto; margin-top: 2px; color: var(--marca); }

    footer { border-top: 1px solid var(--linea); padding-block: 24px calc(24px + 72px); color: var(--tinta-2); font-size: .9rem; }
    footer .in { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: center; }
    footer a { color: var(--tinta); text-decoration: none; }

    .barra { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 10px max(16px, env(safe-area-inset-left,0px)) calc(10px + env(safe-area-inset-bottom,0px)) max(16px, env(safe-area-inset-right,0px)); background: color-mix(in oklab, var(--fondo) 88%, transparent); backdrop-filter: blur(10px); border-top: 1px solid var(--linea); }
    .barra .btn { width: 100%; }
    @media (min-width: 760px) { .barra { display: none; } footer { padding-bottom: 24px; } }
  </style>

  <header class="gutter">
    <div class="top wrap">
      <a class="name" href="#top"><Mark nombre={site.nombre} logo={site.logo} size={42} /> {site.nombre}</a>
      {tel && <a class="tel" href={tel}><Icon name="phone" size={16} /> {site.telefono}</a>}
    </div>
  </header>

  <main class="gutter" id="top">
    <section class="hero wrap">
      <div>
        <h1>{site.tagline}</h1>
        <p>{site.descripcion}</p>
      </div>
      {wa ? (
        <form class="cita" id="cita" data-wa={wa} data-nombre={site.nombre} data-quien={v.quien}>
          <h2>{v.accion}</h2>
          <label>{v.lista.slice(0, -1) === "Tratamiento" ? "Tratamiento" : "Servicio"}
            <select name="tx" id="tx" required>
              <option value="">Elige una opción</option>
              {site.secciones.map((s) => <optgroup label={s.titulo}>{s.items.map((it) => <option value={it.nombre}>{it.nombre}</option>)}</optgroup>)}
            </select>
          </label>
          <div class="row">
            <label>Día <input type="date" name="dia" id="dia" min={hoy} value={hoy} required /></label>
            <label>Turno <select name="turno" id="turno">{turnos.map((t) => <option value={t}>{t}</option>)}</select></label>
          </div>
          <button class="btn" type="submit"><Icon name="whatsapp" size={18} /> Pedir cita por WhatsApp</button>
          <p class="hint">{v.hint}</p>
        </form>
      ) : cta ? <p><a class="btn" href={cta.url}>{cta.label}</a></p> : null}
    </section>

    {site.fotos?.length ? <div class="fotos wrap">{site.fotos.map((f) => <img src={f} alt="" loading="lazy" />)}</div> : null}

    <section class="lista wrap" id="tratamientos">
      <h2>{v.lista}</h2>
      {v.nota && <p class="nota">{v.nota}</p>}
      {site.secciones.map((s) => (
        <div class="grupo">
          <h3>{s.titulo}</h3>
          {s.nota && <p class="nota">{s.nota}</p>}
          <ul class="items">
            {s.items.map((it) => (
              <li class="item">
                <span class="n">{it.nombre}{it.destacado && <span class="dot" title="El más solicitado" />}</span>
                <span class="p">{precio(it.precio)}{it.duracion && <small>{it.duracion}</small>}</span>
                {it.descripcion && <span class="d">{it.descripcion}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="ficha wrap" id="visita">
      <div>
        <h2>Horario</h2>
        <ul class="horas">{site.horario.map((h) => <li><span>{h.dias}</span><span>{h.horas}</span></li>)}</ul>
      </div>
      <div>
        <h2>Dónde</h2>
        <div class="datos">
          {site.direccion && (site.mapa ? <a href={site.mapa} target="_blank" rel="noreferrer"><Icon name="pin" /> <span>{site.direccion}</span></a> : <p><Icon name="pin" /> <span>{site.direccion}</span></p>)}
          {tel && <a href={tel}><Icon name="phone" /> <span>{site.telefono}</span></a>}
          {site.instagram && <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noreferrer"><Icon name="instagram" /> <span>@{site.instagram}</span></a>}
          {site.facebook && <a href={`https://facebook.com/${site.facebook}`} target="_blank" rel="noreferrer"><Icon name="facebook" /> <span>Facebook</span></a>}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="in wrap gutter">
      <span>{site.nombre}</span>
      {site.instagram && <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noreferrer">@{site.instagram}</a>}
    </div>
  </footer>

  {cta && <div class="barra"><a class="btn" href={cta.url} target="_blank" rel="noreferrer"><Icon name="whatsapp" size={18} /> {cta.label}</a></div>}

  <script>
    const f = document.getElementById("cita") as HTMLFormElement | null;
    f?.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = (id: string) => (f.querySelector<HTMLInputElement | HTMLSelectElement>("#" + id)?.value ?? "");
      if (!v("tx")) { f.querySelector<HTMLSelectElement>("#tx")?.focus(); return; }
      const [y, m, d] = v("dia").split("-").map(Number);
      const fecha = new Date(y, m - 1, d).toLocaleDateString("es-MX", { weekday: "long", day: "numeric", month: "long" });
      const quien = f.dataset.quien === "mascota" ? " para mi mascota" : "";
      const msg = `Hola, ${f.dataset.nombre}. Quiero una cita${quien}: ${v("tx")}, el ${fecha}, turno ${v("turno").toLowerCase()}. ¿Tienen espacio?`;
      window.open(`https://wa.me/${f.dataset.wa}?text=${encodeURIComponent(msg)}`, "_blank", "noopener");
    });
  </script>
</Base>
