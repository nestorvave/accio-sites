---
/**
 * Plantilla RESTAURANTE — mundo visual: la carta impresa sobre el mantel.
 * Papel claro, tinta, un solo color de vino. El nombre va como letrero, la carta con puntos guía
 * (la convención real de los menús), y la reservación es un formulario que abre WhatsApp con todo listo.
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import { type Site, precio, reservaLink, telLink, waNumber, textoSobre } from "../lib/sites";

interface Props { site: Site }
const { site } = Astro.props;
const c = {
  fondo: "#FFFCF6",
  tinta: "#1C1A17",
  marca: "#7A1F2B",
  papel: "#F4EEE3",
  ...(site.colores ?? {}),
};
const cta = reservaLink(site);
const tel = telLink(site);
const wa = waNumber(site);
const fonts = "https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,900;1,9..144,500&family=Instrument+Sans:wght@400;500;600&display=swap";
const horas = ["8:00","9:00","10:00","11:00","12:00","13:00","14:00","15:00","16:00","17:00","18:00","19:00","20:00","21:00"];
const hoy = new Date().toISOString().slice(0, 10);
---
<Base site={site} fonts={fonts} themeColor={c.marca} colores={{ ...c, "sobre-marca": textoSobre(c.marca) }}>
  <style>
    :global(:root) {
      --tinta-2: color-mix(in oklab, var(--tinta) 64%, var(--fondo));
      --linea: color-mix(in oklab, var(--tinta) 16%, transparent);
      --f-display: "Fraunces", Georgia, serif;
      --f-body: "Instrument Sans", system-ui, sans-serif;
    }
    :global(body) { background: var(--fondo); color: var(--tinta); font-family: var(--f-body); font-size: 16px; line-height: 1.55; }

    /* Letrero */
    .letrero { text-align: center; padding-block: 28px 10px; max-width: 980px; margin-inline: auto; }
    .letrero :global(.mark) { margin-inline: auto; }
    .letrero h1 { margin-top: 18px; font-family: var(--f-display); font-weight: 900; font-variation-settings: "opsz" 144, "SOFT" 60; font-size: clamp(2.8rem, 10vw, 7rem); line-height: .92; letter-spacing: -.035em; text-wrap: balance; color: var(--marca); }
    .letrero h1 { opacity: 1; transform: none; transition: opacity 600ms var(--ease-out), transform 600ms var(--ease-out); }
    @starting-style { .letrero h1 { opacity: 0; transform: translateY(10px); } }
    .letrero .tag { margin-top: 14px; font-family: var(--f-display); font-style: italic; font-weight: 500; font-size: clamp(1.15rem, 2.6vw, 1.5rem); color: var(--tinta-2); }
    .regla { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px; margin: 26px auto 0; max-width: 980px; color: var(--marca); }
    .regla::before, .regla::after { content: ""; height: 3px; border-top: 1px solid currentColor; border-bottom: 1px solid currentColor; transform-origin: center; transform: scaleX(1); transition: transform 900ms var(--ease-out) 150ms; }
    @starting-style { .regla::before, .regla::after { transform: scaleX(0); } }

    .intro { max-width: 62ch; margin: 28px auto 0; text-align: center; font-size: 1.08rem; color: var(--tinta-2); text-wrap: pretty; }

    /* Reservar: formulario real */
    .reservar { max-width: 760px; margin: 32px auto 0; background: var(--papel); border-radius: 20px; padding: 18px; display: grid; gap: 10px; grid-template-columns: 1fr; }
    @media (min-width: 640px) { .reservar { grid-template-columns: 1fr 1fr 1fr auto; align-items: end; } }
    .reservar label { display: grid; gap: 6px; font-size: .8rem; font-weight: 600; letter-spacing: .02em; color: var(--tinta-2); }
    .reservar select, .reservar input { height: 48px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--linea); background: var(--fondo); color: var(--tinta); font: inherit; font-size: 1rem; width: 100%; appearance: none; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 48px; padding: 0 20px; border-radius: 12px; background: var(--marca); color: var(--sobre-marca); font-weight: 600; text-decoration: none; white-space: nowrap; transition: transform var(--t-fast) var(--ease-out), filter var(--t-fast) var(--ease-out); }
    .btn:hover { filter: brightness(1.08); } .btn:active { transform: scale(.98); }
    .reservar .hint { grid-column: 1 / -1; font-size: .85rem; color: var(--tinta-2); margin: 0; }

    .fotos { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); max-width: 980px; margin: 40px auto 0; }
    .fotos img { aspect-ratio: 1; object-fit: cover; border-radius: 14px; }

    /* La carta */
    .carta { max-width: 980px; margin: 56px auto 0; columns: 1; column-gap: 56px; }
    @media (min-width: 820px) { .carta { columns: 2; } }
    .grupo { break-inside: avoid; margin-bottom: 40px; }
    .grupo h2 { font-family: var(--f-display); font-weight: 700; font-variation-settings: "opsz" 72; font-size: 1.9rem; letter-spacing: -.02em; color: var(--marca); }
    .grupo .nota { color: var(--tinta-2); font-size: .92rem; margin-top: 4px; }
    .platos { margin-top: 14px; display: grid; gap: 14px; }
    .plato .linea { display: flex; align-items: baseline; gap: 8px; }
    .plato .n { font-weight: 600; font-size: 1.05rem; }
    .plato .n .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--marca); margin-left: 8px; vertical-align: middle; }
    .plato .guia { flex: 1; border-bottom: 2px dotted var(--linea); transform: translateY(-5px); min-width: 16px; }
    .plato .p { font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
    .plato .d { color: var(--tinta-2); font-size: .93rem; margin-top: 2px; max-width: 48ch; }

    .ficha { max-width: 980px; margin: 24px auto 0; padding: 28px 0 56px; border-top: 1px solid var(--linea); display: grid; gap: 28px; grid-template-columns: 1fr; }
    @media (min-width: 760px) { .ficha { grid-template-columns: 1fr 1fr; gap: 48px; } }
    .ficha h2 { font-family: var(--f-display); font-weight: 700; font-size: 1.5rem; margin-bottom: 12px; }
    .horas li { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px dotted var(--linea); }
    .horas li span:last-child { font-variant-numeric: tabular-nums; color: var(--tinta-2); }
    .datos { display: grid; gap: 12px; }
    .datos a, .datos p { display: flex; gap: 12px; align-items: flex-start; text-decoration: none; line-height: 1.4; }
    .datos a:hover { text-decoration: underline; }
    .datos :global(svg) { flex: 0 0 auto; margin-top: 2px; color: var(--marca); }

    footer { background: var(--marca); color: var(--sobre-marca); padding-block: 26px calc(26px + 72px); font-size: .9rem; }
    footer .in { max-width: 1020px; margin-inline: auto; display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: center; }
    footer a { text-decoration: none; }

    .barra { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 10px max(16px, env(safe-area-inset-left,0px)) calc(10px + env(safe-area-inset-bottom,0px)) max(16px, env(safe-area-inset-right,0px)); background: color-mix(in oklab, var(--fondo) 88%, transparent); backdrop-filter: blur(10px); border-top: 1px solid var(--linea); }
    .barra .btn { width: 100%; }
    @media (min-width: 760px) { .barra { display: none; } footer { padding-bottom: 26px; } }
  </style>

  <main class="gutter">
    <header class="letrero">
      <Mark nombre={site.nombre} logo={site.logo} size={72} />
      <h1>{site.nombre}</h1>
      <p class="tag">{site.tagline}</p>
      <div class="regla" aria-hidden="true"><Icon name="fork" size={22} /></div>
    </header>

    <p class="intro">{site.descripcion}</p>

    {wa && (
      <form class="reservar" id="reservar" data-wa={wa} data-nombre={site.nombre}>
        <label>Personas
          <select name="personas" id="personas">{[1,2,3,4,5,6,7,8].map((n) => <option value={n} selected={n === 2}>{n}</option>)}</select>
        </label>
        <label>Día
          <input type="date" name="dia" id="dia" min={hoy} value={hoy} required />
        </label>
        <label>Hora
          <select name="hora" id="hora">{horas.map((h) => <option value={h} selected={h === "14:00"}>{h}</option>)}</select>
        </label>
        <button class="btn" type="submit"><Icon name="whatsapp" size={18} /> Reservar</button>
        <p class="hint">Te confirmamos la mesa por WhatsApp. Grupos de más de 8, escríbenos directo.</p>
      </form>
    )}
    {!wa && cta && <p style="text-align:center;margin-top:28px"><a class="btn" href={cta.url}>{cta.label}</a></p>}

    {site.fotos?.length ? <div class="fotos">{site.fotos.map((f) => <img src={f} alt="" loading="lazy" />)}</div> : null}

    <section class="carta" id="carta" aria-label="Carta">
      {site.secciones.map((s) => (
        <div class="grupo">
          <h2>{s.titulo}</h2>
          {s.nota && <p class="nota">{s.nota}</p>}
          <ul class="platos">
            {s.items.map((it) => (
              <li class="plato">
                <div class="linea">
                  <span class="n">{it.nombre}{it.destacado && <span class="dot" title="Favorito de la casa" />}</span>
                  {typeof it.precio === "number" && <><span class="guia" /><span class="p">{precio(it.precio)}</span></>}
                </div>
                {it.descripcion && <p class="d">{it.descripcion}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="ficha" id="visita">
      <div>
        <h2>Horario</h2>
        <ul class="horas">{site.horario.map((h) => <li><span>{h.dias}</span><span>{h.horas}</span></li>)}</ul>
      </div>
      <div>
        <h2>Dónde</h2>
        <div class="datos">
          {site.direccion && (site.mapa
            ? <a href={site.mapa} target="_blank" rel="noreferrer"><Icon name="pin" /> <span>{site.direccion}</span></a>
            : <p><Icon name="pin" /> <span>{site.direccion}</span></p>)}
          {tel && <a href={tel}><Icon name="phone" /> <span>{site.telefono}</span></a>}
          {site.instagram && <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noreferrer"><Icon name="instagram" /> <span>@{site.instagram}</span></a>}
          {site.facebook && <a href={`https://facebook.com/${site.facebook}`} target="_blank" rel="noreferrer"><Icon name="facebook" /> <span>Facebook</span></a>}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="in gutter">
      <span>{site.nombre}</span>
      {site.instagram && <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noreferrer">@{site.instagram}</a>}
    </div>
  </footer>

  {cta && <div class="barra"><a class="btn" href={cta.url} target="_blank" rel="noreferrer"><Icon name="whatsapp" size={18} /> {cta.label}</a></div>}

  <script>
    const f = document.getElementById("reservar") as HTMLFormElement | null;
    f?.addEventListener("submit", (e) => {
      e.preventDefault();
      const v = (id: string) => (f.querySelector<HTMLInputElement | HTMLSelectElement>("#" + id)?.value ?? "");
      const [y, m, d] = v("dia").split("-").map(Number);
      const fecha = new Date(y, m - 1, d).toLocaleDateString("es-MX", { weekday: "long", day: "numeric", month: "long" });
      const msg = `Hola, ${f.dataset.nombre}. Quiero reservar mesa para ${v("personas")} el ${fecha} a las ${v("hora")}.`;
      window.open(`https://wa.me/${f.dataset.wa}?text=${encodeURIComponent(msg)}`, "_blank", "noopener");
    });
  </script>
</Base>
